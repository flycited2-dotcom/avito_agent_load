[Unit]
Description=Collect and queue Avito appliance content cards
Wants=network-online.target
After=network-online.target oasis.service ritualb2b-api.service

[Service]
Type=oneshot
WorkingDirectory=/opt/avito-bridge
Environment=PYTHONPATH=/opt/avito-bridge/src
ExecStart=/opt/avito-bridge/.venv/bin/python -m avito_bridge.cards_run --config profiles/appliances-btopt.yaml --all
ExecStart=/bin/bash /opt/avito-bridge/run-appliances.sh
